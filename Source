<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tạo thuế: chỉ tạo 1 lần, không ghi đè -->
    <data noupdate="1">
        <!-- VAT 8% cho hóa đơn bán ra (Sales) -->
        <record id="tax_vat_8_sale" model="account.tax">
            <field name="name">VAT 8% (Bán ra)</field>
            <field name="amount">8.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="active" eval="True"/>
        </record>

        <!-- VAT 8% cho hóa đơn mua vào (Purchase) -->
        <record id="tax_vat_8_purchase" model="account.tax">
            <field name="name">VAT 8% (Mua vào)</field>
            <field name="amount">8.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="active" eval="True"/>
        </record>
    </data>

    <!-- Cập nhật thuế mặc định cho công ty: LUÔN ghi đè (noupdate="0") -->
    <data noupdate="0">
        <record id="base.main_company" model="res.company">
            <field name="account_sale_tax_id" ref="tax_vat_8_sale"/>
            <field name="account_purchase_tax_id" ref="tax_vat_8_purchase"/>
        </record>
    </data>
</odoo>


