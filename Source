from odoo import models, fields


class AccountMoveSend(models.TransientModel):
    """
    Kế thừa wizard gửi hóa đơn của Odoo.
    Tắt mặc định tùy chọn gửi email khi xuất hóa đơn,
    vì nhà thuốc ưu tiên in hóa đơn trực tiếp tại quầy.
    """
    _inherit = 'account.move.send'

    # Ghi đè default = False để hệ thống không tự chọn gửi email
    checkbox_send_mail = fields.Boolean(default=False)


