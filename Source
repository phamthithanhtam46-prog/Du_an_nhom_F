from odoo import models, fields, api


class SaleOrderLine(models.Model):
    """
    Kế thừa dòng đơn hàng Sale để tự động điền thuế VAT 8%
    khi dược sĩ thêm sản phẩm vào đơn hàng trong phân hệ Sales.
    """
    _inherit = 'sale.order.line'

    @api.onchange('product_id')
    def _onchange_product_id_set_vat8(self):
        """
        Sau khi Odoo gán thuế mặc định từ sản phẩm,
        nếu dòng vẫn không có thuế → tự động điền VAT 8% (Bán ra).
        """
        if not self.product_id:
            return
        if not self.tax_id:
            vat_8 = self.env['account.tax'].search([
                ('type_tax_use', '=', 'sale'),
                ('amount', '=', 8.0),
                ('active', '=', True),
                ('company_id', '=', self.company_id.id),
            ], limit=1)
            if vat_8:
                self.tax_id = vat_8

    def _get_tax_ids(self):
        """
        Ghi đè phương thức tính thuế của Odoo.
        Nếu kết quả trả về rỗng (không có thuế), tự động dùng VAT 8%.
        Đây là điểm chặn cuối cùng để đảm bảo luôn có thuế trên dòng SO.
        """
        tax_ids = super()._get_tax_ids()
        if not tax_ids:
            company = self.order_id.company_id or self.env.company
            vat_8 = self.env['account.tax'].search([
                ('type_tax_use', '=', 'sale'),
                ('amount', '=', 8.0),
                ('active', '=', True),
                ('company_id', '=', company.id),
            ], limit=1)
            return vat_8
        return tax_ids


