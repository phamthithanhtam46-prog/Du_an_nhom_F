<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pharmacy_consultation_request_tree" model="ir.ui.view">
        <field name="name">pharmacy.consultation.request.tree</field>
        <field name="model">pharmacy.consultation.request</field>
        <field name="arch" type="xml">
            <tree string="Yêu cầu tư vấn thuốc">
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="product_id"/>
                <field name="pharma_product_type"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_pharmacy_consultation_request_form" model="ir.ui.view">
        <field name="name">pharmacy.consultation.request.form</field>
        <field name="model">pharmacy.consultation.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu tư vấn thuốc">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="pharma_product_type"/>
                        <field name="customer_name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="note"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_consultation_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu tư vấn thuốc</field>
        <field name="res_model">pharmacy.consultation.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pharmacy_consultation_root"
          name="Tư vấn thuốc"
          parent="sale.sale_menu_root"
          action="action_pharmacy_consultation_request"
          sequence="80"/>

</odoo>