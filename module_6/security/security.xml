<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pharmacy" model="ir.module.category">
        <field name="name">Pharmacy Management</field>
        <field name="description">Category for managing pharmacy prescriptions and sales.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_pharmacy_pharmacist" model="res.groups">
        <field name="name">Pharmacist / Dược sĩ</field>
        <field name="category_id" ref="module_category_pharmacy"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
