<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prescription_customer_wizard_form" model="ir.ui.view">
        <field name="name">pharmacy.prescription.customer.wizard.form</field>
        <field name="model">pharmacy.prescription.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo khách hàng cho đơn thuốc">
                <sheet>
                    <group>
                        <field name="prescription_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="street"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_customer_and_confirm" type="object" string="Tạo khách hàng và tạo đơn bán" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
