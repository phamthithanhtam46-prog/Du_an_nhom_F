<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_rx" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rx</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Thông tin Xác nhận Rx (Chỉ xem)" name="rx_info">
                    <field name="is_rx_prescription"/>
                    <field name="rx_pharmacist_id" invisible="not is_rx_prescription"/>
                    <field name="is_rx_confirmed" invisible="not is_rx_prescription"/>
                    <field name="rx_confirmation_note" invisible="not is_rx_prescription"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
