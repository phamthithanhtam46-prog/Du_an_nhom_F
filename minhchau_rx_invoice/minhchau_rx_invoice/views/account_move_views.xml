<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_rx" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rx</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Thông tin Xác nhận Rx" name="rx_info">
                    <field name="is_rx_prescription"/>
                    <field name="rx_pharmacist_id" invisible="not is_rx_prescription"/>
                    <field name="is_rx_confirmed" invisible="not is_rx_prescription"/>
                    <field name="rx_confirmation_note" invisible="not is_rx_prescription"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
