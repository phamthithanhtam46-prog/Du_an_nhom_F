<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_minhchau_stock_error_wizard" model="ir.ui.view">
        <field name="name">minhchau.stock.error.wizard.form</field>
        <field name="model">minhchau.stock.error.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Validation Error">
                <sheet>

                    <!-- Tiêu đề đỏ -->
                    <div style="
                        background: #fff5f5;
                        border-left: 5px solid #dc3545;
                        border-radius: 6px;
                        padding: 12px 16px;
                        margin-bottom: 16px;
                    ">
                        <field name="title" readonly="1"
                               style="font-size: 14px; font-weight: bold; color: #dc3545; text-transform: uppercase;"/>
                    </div>

                    <!-- Chi tiết lỗi - nền vàng -->
                    <div style="
                        background: #fff3cd;
                        border-left: 5px solid #ffc107;
                        border-radius: 6px;
                        padding: 12px 16px;
                        margin-bottom: 16px;
                        white-space: pre-wrap;
                        font-family: monospace;
                        font-size: 13px;
                    ">
                        <field name="message" readonly="1" widget="text"/>
                    </div>

                    <!-- Hướng dẫn khi có SO - nền xanh lá -->
                    <div invisible="not sale_order_id" style="
                        background: #d4edda;
                        border-left: 5px solid #28a745;
                        border-radius: 6px;
                        padding: 10px 16px;
                        margin-bottom: 12px;
                        font-size: 13px;
                        color: #155724;
                    ">
                        💡 Nhấn <strong>"Đổi Sản Phẩm"</strong> để tự động set số lượng = 0
                        cho sản phẩm lỗi và mở SO để thêm sản phẩm thay thế.
                    </div>

                    <!-- Link Sale Order - nền xanh dương -->
                    <div invisible="not sale_order_id" style="
                        background: #d1ecf1;
                        border-left: 5px solid #17a2b8;
                        border-radius: 6px;
                        padding: 10px 16px;
                        font-size: 13px;
                    ">
                        🔗 Linked Sale Order:
                        <strong><field name="sale_order_name" readonly="1"/></strong>
                    </div>

                    <!-- Fields ẩn -->
                    <field name="picking_id" invisible="1"/>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="error_type" invisible="1"/>

                </sheet>

                <footer>
                    <!--
                        Đổi Sản Phẩm: set qty=0 dòng lỗi + mở SO để thêm sản phẩm mới.
                        Hiện khi có SO liên kết.
                    -->
                    <button name="action_replace_products"
                            string="🔄 Đổi Sản Phẩm"
                            type="object"
                            class="btn-primary"
                            invisible="not sale_order_id"
                            confirm="Hệ thống sẽ tự động set số lượng = 0 cho sản phẩm lỗi. Bạn có muốn tiếp tục?"/>

                    <!-- Vẫn Xác Nhận: chỉ khi thiếu số lượng, không có hết hạn -->
                    <button name="action_validate_anyway"
                            string="Vẫn Xác Nhận"
                            type="object"
                            class="btn-warning"
                            invisible="error_type != 'insufficient'"
                            confirm="Số lượng tồn kho không đủ. Bạn có chắc muốn tiếp tục xác nhận?"/>

                    <!-- Go to Sale Order (thủ công) -->
                    <button name="action_go_to_sale_order"
                            string="🔗 Go to Sale Order"
                            type="object"
                            class="btn-secondary"
                            invisible="not sale_order_id"/>

                    <!-- Đóng -->
                    <button name="action_close"
                            string="Đóng"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>